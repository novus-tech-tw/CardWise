  "findings": [
    {
      "id": "CPTL-01",
      "observation": "Widget body constructs IntentConfiguration with the exact intent/provider; resilient witness binds provider getTimeline to 0x10007188c -> 0x10007b728.",
      "inference": "This is the actual shipped configuration/provider timeline requirement path.",
      "limits": "The OS did not invoke the extension during this investigation."
    },
    {
      "id": "CPTL-02",
      "observation": "Missing option/identifier synthesizes String 0; valid 0 selects first getDefaultDBPointerParents(sortBy:1) result, ordered lastViewedAt descending, sort_order/name ascending. Valid nonzero ID selects a matching parent.id. Invalid or absent matching ID yields no entry.",
      "inference": "Default selection implements the last-viewed configuration option in this finite path.",
      "limits": "Current data, nil-date ordering and runtime fetch success are not established."
    },
    {
      "id": "CPTL-03",
      "observation": "Entry card-state helper consumes smartPointerCardsSortedWithSponsored and resolvedWidgetProfileUUID(nil), with suite group.getcardpointers.app/key focusUser/empty-string fallback; ALL_PROFILES is String 0. It permits matching or missing inventory.profile_uuid, then computes sponsored-true count < 2.",
      "inference": "Profile filtering here feeds the field named userHasCards; it is separate from parent-ID selection.",
      "limits": "Upstream sponsored-card getter and downstream render filtering are not expanded."
    },
    {
      "id": "CPTL-04",
      "observation": "Selected record yields one Date()-stamped PointersWidgetOneEntry, isPlaceholder false and config flags. Fetch empty/error or missing ID yields empty entries. Both call Timeline(entries:policy:) with exact never policy import and invoke completion.",
      "inference": "This timeline does not request a timed refresh.",
      "limits": "No conclusion about external reloads, OS scheduling or rendering."
    }
  ],
