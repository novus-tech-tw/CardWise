{"id":2918492,"authors":[{"id":18852671,"name":"CardPointers","url":"https://addons.mozilla.org/en-US/firefox/user/18852671/","username":"anonymous-77253f3dd7b423e1fed23ece045436c6","picture_url":null}],"average_daily_users":1695,"categories":["shopping"],"contributions_url":"","created":"2025-06-01T23:20:24Z","current_version":{"id":6552561,"compatibility":{"firefox":{"min":"109.0a1","max":"*"},"android":{"min":"120.0","max":"*"}},"edit_url":"https://addons.mozilla.org/en-US/developers/addon/cardpointers-x/versions/6552561","file":{"id":5096700,"created":"2026-10-07T20:38:51Z","hash":"sha256:691c287f0c640e5c0cefd77fed49c3e9e6a4630ee0c8461a3e2fdf6022327af3","is_mozilla_signed_extension":false,"size":792134,"status":"public","url":"https://addons.mozilla.org/firefox/downloads/file/5096700/cardpointers_x-8.0.8.xpi","permissions":["storage","unlimitedStorage","activeTab","scripting","http://*/*","https://*/*"],"optional_permissions":[],"host_permissions":["http://*/*","https://*/*"],"data_collection_permissions":[],"optional_data_collection_permissions":[]},"is_strict_compatibility_enabled":false,"license":{"id":7057,"is_custom":false,"name":{"en-US":"All Rights Reserved"},"slug":"all-rights-reserved","url":null},"release_notes":{"en-US":"FIx for a Bank of America change, and better handle subdomains for surfacing offers."},"reviewed":"2026-10-07T20:41:39Z","version":"8.0.8"},"default_locale":"en-US","description":{"en-US":"Maximize your Amex/Chase offers, cashback &amp; all of your credit card rewards on every site.\n\nLove saving money? CardPointers helps you get the most out of your credit card offers and category bonuses, automatically.\n\nAuto-add every one of your Amex, Chase, BoA, Wells Fargo, US Bank, and Citi offers with CardPointers, and then the extension will help you use them, automatically.\n\nEveryone loves Amex and Chase Offers, but they're normally a pain to activate, one by one -- now you can automatically activate every offer as soon as you log in -- even the same offer across multiple eligible cards, all without having to ever share your bank logins.\n\nCardPointers also gives you a new way to view all of the offers across all of your cards, sort and filter every one of them by value, minimum spend, category, and more, and activate just the ones you want with a single click -- you're always in control.\n\nDo you keep forgetting to use your offers or never remember which credit card to use to earn more points when you're shopping online? Now any time you're on a website where you have an activated offer or a category bonus on your card, you'll see all of the offer &amp; card details floating on the bottom of the site in the Shopping Pointers bar so you'll know which card to use, automatically.\n\nIt's never been easier to save money -- most users save over $750 per year!"},"developer_comments":{"en-US":"This is the first Firefox version of the extension; if you run into any issues, please email support@cardpointers.com with details + screenshots. Thank you!"},"edit_url":"https://addons.mozilla.org/en-US/developers/addon/cardpointers-x/edit","guid":"firefox@cardpointers.com","has_eula":false,"has_privacy_policy":true,"homepage":{"url":{"en-US":"https://cardpointers.com/"},"outgoing":{"en-US":"https://prod.outgoing.prod.webservices.mozgcp.net/v1/695d8613ebbb5ba3635cdd58bda1c3a3aba421e0d40327e687ffec3a59ea6cec/https%3A//cardpointers.com/"}},"icon_url":"https://addons.mozilla.org/user-media/addon_icons/2918/2918492-64.png?modified=e444578c","icons":{"32":"https://addons.mozilla.org/user-media/addon_icons/2918/2918492-32.png?modified=e444578c","64":"https://addons.mozilla.org/user-media/addon_icons/2918/2918492-64.png?modified=e444578c","128":"https://addons.mozilla.org/user-media/addon_icons/2918/2918492-128.png?modified=e444578c"},"is_disabled":false,"is_experimental":false,"is_noindexed":false,"last_updated":"2026-10-07T20:41:39Z","name":{"en-US":"CardPointers X"},"previews":[{"id":322365,"caption":{"en-US":"Card